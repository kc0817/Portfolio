---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import AboutMe from '../components/AboutMe.astro';
import Portfolio from '../components/Portfolio.astro';
import ExploreMore from '../components/ExploreMore.astro';
import { PORTRAIT } from '../lib/portrait';

/**
 * The site, essentially. The four topic pages this page used to point at are gone,
 * so `Portfolio` holds all of the work rather than four links to it, and the only
 * pages left below this one are the three projects' own.
 *
 * The three sections the nav names — About, Portfolio, Explore More — are the three
 * components below the hero, in this order. `SECTIONS` in `lib/site.ts` is the list;
 * keep the two in step.
 */
---

{/* The header only loses its rule when there is a photo for it to ride on. */}
<Base transparentHeader={Boolean(PORTRAIT)}>
  <Hero />
  <AboutMe />
  <Portfolio />
  <ExploreMore />
</Base>
