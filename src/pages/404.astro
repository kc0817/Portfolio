---
import Base from '../layouts/Base.astro';
import { SECTIONS, sectionUrl } from '../lib/site';

/**
 * This used to list the four divisions, each with its own hue on a left rule. Those
 * pages are gone, and so is the hue set — the work now lives in three sections of
 * the home page. So does the way back: the two nav destinations, which is the whole
 * site.
 *
 * The likeliest arrival here is an old `/robotics`, `/math`, `/games`, or
 * `/projects/ftc-8393-decode` link, so the copy says the page moved rather than
 * implying the visitor mistyped.
 */
---

<Base title="Page not found">
  <div class="prose-wrap missing">
    <p class="label">404</p>
    <h1>That page isn&rsquo;t here.</h1>
    <p class="missing__note">
      The site used to spread across a page per topic. It is one page now, so a link
      to a division or an older project has nowhere to land — but everything those
      pages held is still here, further down the home page.
    </p>
    <ul class="missing__links">
      {
        SECTIONS.map((section) => (
          <li>
            <a href={sectionUrl(section.id)}>{section.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .missing {
    padding-block: var(--s-9) var(--section-y);
  }

  .missing h1 {
    font-size: var(--text-3xl);
    letter-spacing: -0.038em;
    margin-block: var(--s-3) var(--s-4);
  }

  .missing__note {
    color: var(--ink-secondary);
    max-width: 54ch;
    margin-bottom: var(--s-6);
  }

  .missing__links {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }

  /* The rule was tinted per division. With no division hues left it takes the
     structural accent, which is what every other marker on the site uses. */
  .missing__links a {
    display: inline-block;
    color: var(--ink);
    text-decoration: none;
    font-weight: 560;
    border-left: 2px solid var(--accent-blue-light);
    padding-left: var(--s-3);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .missing__links a:hover {
    color: var(--link);
  }
</style>
