---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import ProjectDetail from '../components/ProjectDetail.astro';
import RoboticsShowcase from '../components/RoboticsShowcase.astro';
import { CATEGORIES } from '../content.config';
import { accentVars, CATEGORY_META } from '../lib/site';
import { DIVISION_IMAGE } from '../lib/divisionImages';

/** Each division gets the figure that belongs to its own subject matter. */
const FIGURE = {
  robotics: 'spline',
  research: 'contours',
  math: 'cube',
  games: 'linkage',
} as const;

// Deliberately not annotated `: GetStaticPaths` — that widens the return type to
// the generic result and leaves `Astro.props` as `unknown`. Inference gives the
// real shape, which is what `InferGetStaticPropsType` below reads.
export const getStaticPaths = async () => {
  const all = await getCollection('projects', ({ data }) => !data.draft);

  return CATEGORIES.map((category) => ({
    params: { category },
    props: {
      category,
      projects: all
        .filter((p) => p.data.category === category)
        .sort((a, b) => b.data.weight - a.data.weight),
    },
  }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { category, projects } = Astro.props as Props;
const meta = CATEGORY_META[category];

/**
 * Research has exactly one project, so its page IS that project's page
 * rather than a listing that points at a separate one-item detail page. See
 * the matching note in projects/[...id].astro, which excludes this slug from
 * getting its own URL.
 */
const omrProject = category === 'research' ? projects.find((p) => p.id === 'omr-project') ?? null : null;
---

<Base
  title={omrProject ? omrProject.data.title : meta.label}
  description={omrProject ? omrProject.data.summary : meta.blurb}
>
  {
    omrProject ? (
      <ProjectDetail project={omrProject} prev={null} next={null} />
    ) : (
      <div style={accentVars(category)}>
        <PageIntro
          image={DIVISION_IMAGE[category]}
          alt={`${meta.label} team photo`}
          title={meta.label}
          overview={meta.blurb}
          figure={FIGURE[category]}
        />

        <div class="wrap body">
          {category === 'robotics' ? (
            <RoboticsShowcase projects={projects} />
          ) : projects.length > 0 ? (
            <ProjectGrid projects={projects} />
          ) : (
            <p class="empty">
              Nothing published in this division yet. The work in progress lands here
              when it is far enough along to be worth reading about.
            </p>
          )}
        </div>
      </div>
    )
  }
</Base>

<style>
  .body {
    padding-block: var(--s-2) var(--s-8);
  }

  .empty {
    color: var(--ink-secondary);
    max-width: 52ch;
    padding-block: var(--s-4);
  }
</style>
