---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { PORTFOLIO_ORDER } from '../../lib/portfolioRows';

/**
 * Every published project gets a URL here, AutoOMR included. It used to be the one
 * exception: research had a single project, so `/research` rendered it directly and
 * this route skipped the slug to avoid two URLs for one page. The division pages are
 * gone, so that exception has nothing left to be an exception to — AutoOMR is now a
 * project page like the other five, reached from its card in the portfolio's Research
 * row.
 */
// Not annotated `: GetStaticPaths` on purpose — that widens the return type to the
// generic result and leaves `Astro.props` as `unknown`. Inference gives the real
// shape, which is what `InferGetStaticPropsType` below reads.
export const getStaticPaths = async () => {
  const all = await getCollection('projects', ({ data }) => !data.draft);

  // One sequence across every division, in the same order the home page lays
  // its rows out — robotics, then research, then math. So "next" from the last
  // project in a row carries into the first project of the next row, rather
  // than dead-ending at the end of its own category. A project absent from
  // `PORTFOLIO_ORDER` (published but not yet slotted into a row) falls to the
  // end, ordered by weight, so it still gets neighbours instead of crashing.
  const byOrder = (p: (typeof all)[number]) => {
    const at = PORTFOLIO_ORDER.indexOf(p.id);
    return at === -1 ? Number.POSITIVE_INFINITY : at;
  };
  const ordered = [...all].sort((a, b) => byOrder(a) - byOrder(b) || b.data.weight - a.data.weight);

  return ordered.map((project) => {
    const at = ordered.findIndex((p) => p.id === project.id);

    return {
      params: { id: project.id },
      props: {
        project,
        prev: ordered[at - 1] ?? null,
        next: ordered[at + 1] ?? null,
      },
    };
  });
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project, prev, next } = Astro.props as Props;
---

<Base title={project.data.title} description={project.data.summary}>
  <ProjectDetail project={project} prev={prev} next={next} />
</Base>
