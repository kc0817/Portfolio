---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';

/**
 * Every published project gets a URL here, AutoOMR included. It used to be the one
 * exception: research had a single project, so `/research` rendered it directly and
 * this route skipped the slug to avoid two URLs for one page. The division pages are
 * gone, so that exception has nothing left to be an exception to — AutoOMR is now a
 * project page like the other five, reached from its card in the portfolio's Research
 * row.
 */
// Not annotated `: GetStaticPaths` on purpose — that widens the return type to the
// generic result and leaves `Astro.props` as `unknown`. Inference gives the real
// shape, which is what `InferGetStaticPropsType` below reads.
export const getStaticPaths = async () => {
  const all = await getCollection('projects', ({ data }) => !data.draft);

  return all.map((project) => {
    // Neighbours within the same division, so a visitor who landed here from a
    // direct link has somewhere to go that is not the back button. Ordered by
    // `weight`, which is why the weights have to agree with the row order that
    // Portfolio.astro lays out by hand.
    const siblings = all
      .filter((p) => p.data.category === project.data.category)
      .sort((a, b) => b.data.weight - a.data.weight);
    const at = siblings.findIndex((p) => p.id === project.id);

    return {
      params: { id: project.id },
      props: {
        project,
        prev: siblings[at - 1] ?? null,
        next: siblings[at + 1] ?? null,
      },
    };
  });
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project, prev, next } = Astro.props as Props;
---

<Base title={project.data.title} description={project.data.summary}>
  <ProjectDetail project={project} prev={prev} next={next} />
</Base>
