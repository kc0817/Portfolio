---
import TypeMock from '../../layouts/TypeMock.astro';
import Hero from '../../components/Hero.astro';
import AboutMe from '../../components/AboutMe.astro';
import DemoReel from '../../components/DemoReel.astro';
import { TYPESETS } from '../../lib/typesets';

/**
 * One home page per candidate type system, rendered from the real components
 * so what is being compared is the actual page, not a facsimile of it.
 */
export function getStaticPaths() {
  return TYPESETS.map((typeset) => ({ params: { set: typeset.id } }));
}

const { set } = Astro.params;
---

<TypeMock set={set!}>
  <Hero />
  <AboutMe />
  <DemoReel />
</TypeMock>
