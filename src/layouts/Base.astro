---
// `full.css` is the only Fraunces build carrying both the WONK axis that
// `--vf-display` sets and the `opsz` axis that `font-optical-sizing: auto`
// needs. Optical sizing is most of why this face was worth taking, since the
// same file has to serve an 82px hero and a 40px section heading.
//
// It costs 121 KB for the latin subset against 37 KB for `wonk.css`, which
// carries weight and WONK but no optical sizing. If the payload ever has to
// come down, that swap is the lever: drop the `'SOFT' 18` from `--vf-display`
// (a small move off the default anyway) and accept one optical cut at every
// size. Nothing blocks on it either way. Every face here is
// `font-display: swap`, and the Georgia fallback is a serif of similar
// proportion, so the swap is a shift rather than a reflow.
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/ibm-plex-sans';
// Plex Mono has no variable build. Only the two weights the system actually
// uses are loaded: 400 for inline code, 500 for every tracked label.
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { SITE, url } from '../lib/site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  /** Suppresses the header's bottom rule where a full-bleed hero follows it. */
  transparentHeader?: boolean;
}

const {
  title,
  description = `${SITE.descriptor}. Robotics, graphics, and research projects by ${SITE.name}.`,
  transparentHeader = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.descriptor}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://kc0817.github.io');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#f6f5f3" />
  </head>
  <body>
    <!--
      THESIS: A Purdue CS undergrad's project record that earns trust by making
      depth of implementation visible — renderers, physics, parsers, path
      followers, vision pipelines built where no library existed. It refuses the
      undifferentiated nine-equal-cards grid; work is ranked, cut, and divided.
      OWN-WORLD: Light only. Near-white ground, near-black ink, cool neutral
      rules, two blues and no third family — dark for structure (links, focus,
      the primary action), light as material (marks, borders) and never as type
      on the ground. Fraunces on the two display tiers only, IBM Plex Sans for
      everything read, IBM Plex Mono for real data. One spacing rhythm,
      offset-plus-blur depth.
      STORY: A visitor learns who Kevin is, then reads the work itself — six
      projects in three divisions, each card playing its own demo — without
      following a link to get to any of it.
      SHAPE: One page. It was five (a home page plus four topic pages); the
      project list was cut from fifteen to six so the work could live on the
      page that used to only point at it. Six project pages sit below, and
      nothing else does. A curated six beats a complete fifteen.
      FIRST VIEWPORT: Full-bleed portrait, "Hello everyone, I'm Kevin Chen"
      overlaid at the vertical middle.
      FORM: The standing exit — the category standard, taken by the user over
      assigned candidate 7. Seed key d5809468.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // Applies the settle animation to major sections as they arrive. Entirely
      // additive: the class is only ever added by this script, so a visitor
      // without JavaScript gets every section in its finished state, and a
      // visitor who never scrolls still sees the whole page.
      const still = matchMedia('(prefers-reduced-motion: reduce)');

      if ('IntersectionObserver' in window && !still.matches) {
        // Two kinds of arriving block, one observer.
        //
        // A `[data-rise]` block takes the authored `rise` entrance and is observed
        // directly, wherever it sits in the tree — which is what lets the three
        // divisions inside the portfolio section each rise on their own as the
        // visitor reaches them. Every other `main > section` takes the gentler
        // `settle`, except one that contains risers: its parts are carrying the
        // arrival, so the section animating too would be a second gesture over the
        // top of the first.
        const risers = [...document.querySelectorAll<HTMLElement>('main [data-rise]')];
        const isRiser = new Set(risers);

        // `rise` starts from opacity 0, so a riser has to be hidden here rather
        // than in the stylesheet. Arming from script is what keeps the
        // Never-Hide-Content guarantee: no JS, no IntersectionObserver, or reduced
        // motion all skip this block entirely and every section renders in its
        // finished state. It runs in the same task as the observer setup, so the
        // armed state is in place before the first paint and nothing flashes in
        // before it rises.
        risers.forEach((el) => el.classList.add('is-armed'));

        // One query so the result comes back in document order, which is what the
        // slice below depends on.
        const targets = [
          ...document.querySelectorAll<HTMLElement>(
            'main > section, main > article > section, main [data-rise]',
          ),
        ].filter((el) => isRiser.has(el) || !el.querySelector('[data-rise]'));

        // Set by the first callback of any kind, which on a healthy page arrives
        // within a frame or two of `observe()` — an IntersectionObserver reports on
        // every target it is given, immediately, whether or not it intersects.
        let reported = false;

        const observer = new IntersectionObserver(
          (entries) => {
            reported = true;
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('settle');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        );

        // The first block is already on screen at load; animating it would mean
        // the page arrives mid-transition rather than composed.
        targets.slice(1).forEach((el) => observer.observe(el));

        // Failsafe for the one case arming does not cover. `is-armed` holds a block
        // at opacity 0 and hands the job of revealing it to the observer, so an
        // environment where the API exists but never delivers a callback — a tab
        // that is not compositing frames, an embedding that starves it — leaves
        // content hidden indefinitely. That breaks the rule this whole mechanism is
        // built around, and it matters more now that the portfolio is five armed
        // blocks rather than one.
        //
        // Silence for this long means no callback is coming, so everything armed is
        // revealed with no animation at all. Unarming rather than settling is
        // deliberate: six blocks animating at once because a timer fired would be a
        // worse arrival than no animation, and the page would still be wrong.
        setTimeout(() => {
          if (reported) return;
          risers.forEach((el) => el.classList.remove('is-armed'));
        }, 1500);
      }
    </script>
  </body>
</html>
