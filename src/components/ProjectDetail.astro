---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import PageIntro from './PageIntro.astro';
import { accentVars, CATEGORY_META, LINK_LABELS, url } from '../lib/site';

/**
 * The full project page body, shared by every project's own URL and by the
 * research page (which merges with its one project, AutoOMR, instead of
 * pointing at a separate listing). Everything below the intro is unchanged
 * from before this page grew the shared [image, title, Overview] opening —
 * credentials, demo/repo actions, contribution scope, the facts rail, the
 * gallery, and prev/next navigation all still work exactly as they did.
 *
 * `--cat` here is the division's single committed accent (orange or navy),
 * not the division's own tertiary hue — see PAGE_ACCENT and DESIGN.md's
 * "One Accent Per Division Page" rule.
 */
const FIGURE = {
  robotics: 'trajectory',
  research: 'contours',
  math: 'rays',
  games: 'linkage',
} as const;

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}

const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const meta = CATEGORY_META[data.category];
const demo = data.links.find((l) => l.kind === 'demo' || l.kind === 'site');
const others = data.links.filter((l) => l !== demo);

const facts = [
  data.period && { label: 'When', value: data.period },
  data.stack.length > 0 && { label: 'Built with', value: data.stack.join(', ') },
  data.collaborative && {
    label: 'Team',
    value: data.collaborative.owner,
    href: data.collaborative.ownerUrl,
  },
].filter(Boolean) as { label: string; value: string; href?: string }[];
---

<article style={accentVars(data.category)}>
  <PageIntro
    image={data.poster ?? null}
    alt={data.posterAlt ?? `${data.title} running`}
    title={data.title}
    overview={data.summary}
    eyebrow={{ label: meta.label, href: url(`/${data.category}`) }}
    figure={FIGURE[data.category]}
  />

  {
    (data.credentials.length > 0 || demo || others.length > 0) && (
      <div class="wrap credit">
        {data.credentials.length > 0 && (
          <ul class="results">
            {data.credentials.map((c) => (
              <li class="results__item">{c}</li>
            ))}
          </ul>
        )}

        {(demo || others.length > 0) && (
          <div class="actions">
            {demo && (
              <a class="action action--primary" href={demo.href} rel="noopener">
                <Icon name="play" size={16} />
                {demo.label ?? LINK_LABELS[demo.kind]}
              </a>
            )}
            {others.map((link) => (
              <a class="action" href={link.href} rel="noopener">
                <Icon name={link.kind === 'repo' ? 'github' : 'external'} size={16} />
                {link.label ?? LINK_LABELS[link.kind]}
              </a>
            ))}
          </div>
        )}
      </div>
    )
  }

  <div class="wrap layout">
    <div class="prose">
      {
        data.role && (
          <aside class="scope">
            <p class="scope__label label">My contribution</p>
            <p>{data.role}</p>
          </aside>
        )
      }

      <Content />

      {
        data.sourceLost && (
          <p class="lost">
            The source for this project was written on a school device and did not
            survive graduation. The demo above is the working version.
          </p>
        )
      }
    </div>

    {
      facts.length > 0 && (
        <aside class="facts" aria-label="Project details">
          <dl>
            {facts.map((fact) => (
              <div class="facts__row">
                <dt class="label">{fact.label}</dt>
                <dd>
                  {fact.href ? (
                    <a href={fact.href} rel="noopener">
                      {fact.value}
                    </a>
                  ) : (
                    fact.value
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </aside>
      )
    }
  </div>

  {
    data.gallery.length > 0 && (
      <section class="wrap gallery" aria-label="Images">
        {data.gallery.map((item) => (
          <figure class="gallery__item">
            <Image src={item.src} alt={item.alt} widths={[560, 900, 1400]} sizes="(min-width: 58rem) 34rem, 100vw" />
            <figcaption>{item.alt}</figcaption>
          </figure>
        ))}
      </section>
    )
  }

  {
    (prev || next) && (
      <nav class="wrap neighbours" aria-label={`More in ${meta.label}`}>
        {prev ? (
          <a class="neighbour" href={url(`/projects/${prev.id}`)}>
            <span class="label">Previous in {meta.label}</span>
            <span class="neighbour__title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a class="neighbour neighbour--next" href={url(`/projects/${next.id}`)}>
            <span class="label">Next in {meta.label}</span>
            <span class="neighbour__title">{next.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</article>

<style>
  .credit {
    padding-bottom: var(--s-7);
  }

  .results {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .results__item {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--cat-deep);
    border-left: 1px solid var(--cat);
    padding-left: var(--s-3);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }

  .results + .actions {
    margin-top: var(--s-5);
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-5);
    border-radius: var(--radius-md);
    border: 1px solid var(--rule-strong);
    background: var(--ground-raised);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 560;
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .action:hover {
    border-color: var(--ink-tertiary);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .action--primary {
    background: var(--ground-inverse);
    border-color: var(--ground-inverse);
    color: var(--ink-inverse);
  }

  .action--primary:hover {
    color: var(--ink-inverse);
    border-color: var(--ground-inverse);
    box-shadow: var(--shadow-md);
  }

  /* Hardcoded orange rather than var(--cat): the primary button's fill is
     always navy (a site-wide token, not this page's committed accent), so on
     a navy-accent page a --cat ring would repeat the same invisible-on-navy
     problem this override exists to prevent. */
  .action--primary:focus-visible {
    outline-color: var(--accent-orange);
  }

  /* ---- Body -------------------------------------------------------------- */

  .layout {
    display: grid;
    gap: var(--s-7);
    /* Less below than above: the neighbour links bring their own top rule and
       spacing, so a full section's padding here opened a dead band between the
       end of the writing and the way onward. */
    padding-block: var(--s-6) var(--s-7);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 58rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: var(--s-9);
      align-items: start;
    }
  }

  .prose {
    max-width: var(--measure);
  }

  .prose :global(h2) {
    font-size: var(--text-xl);
    margin-top: var(--s-8);
    margin-bottom: var(--s-4);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    font-size: var(--text-lg);
    margin-top: var(--s-7);
    margin-bottom: var(--s-3);
  }

  .prose :global(p) {
    margin-bottom: var(--s-4);
    color: var(--ink-secondary);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--s-5);
    padding-left: var(--s-5);
    display: grid;
    gap: var(--s-2);
    color: var(--ink-secondary);
  }

  .prose :global(li::marker) {
    color: var(--cat);
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 620;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--ground-sunken);
    padding: 0.15em 0.36em;
    border-radius: var(--radius-sm);
  }

  .scope {
    padding: var(--s-5);
    margin-bottom: var(--s-7);
    background: var(--ground-sunken);
    border-radius: var(--radius-md);
    border-top: 2px solid var(--cat);
  }

  .scope__label {
    margin-bottom: var(--s-2);
  }

  .scope p:last-child {
    color: var(--ink);
  }

  .lost {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
    color: var(--ink-tertiary);
    font-size: var(--text-sm);
    max-width: 56ch;
  }

  .facts dl {
    display: grid;
    gap: var(--s-5);
  }

  .facts__row dt {
    margin-bottom: var(--s-1);
  }

  .facts__row dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }

  @media (min-width: 58rem) {
    .facts {
      position: sticky;
      top: 5rem;
      padding-left: var(--s-6);
      border-left: 1px solid var(--rule);
    }
  }

  /* ---- Gallery ----------------------------------------------------------- */

  .gallery {
    display: grid;
    gap: var(--s-6);
    padding-bottom: var(--section-y);
  }

  @media (min-width: 58rem) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .gallery__item :global(img) {
    width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--rule);
  }

  .gallery__item figcaption {
    margin-top: var(--s-3);
    font-size: var(--text-sm);
    color: var(--ink-tertiary);
  }

  /* ---- Neighbours -------------------------------------------------------- */

  .neighbours {
    display: grid;
    gap: var(--s-4);
    padding-bottom: var(--section-y);
    border-top: 1px solid var(--rule);
    padding-top: var(--s-6);
  }

  @media (min-width: 46rem) {
    .neighbours {
      grid-template-columns: 1fr 1fr;
    }
  }

  .neighbour {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .neighbour:hover {
    border-color: var(--rule-strong);
    box-shadow: var(--shadow-sm);
  }

  .neighbour--next {
    text-align: right;
  }

  .neighbour__title {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: var(--track-tight);
  }
</style>
