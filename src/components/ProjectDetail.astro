---
import type { CollectionEntry } from 'astro:content';
import PageIntro from './PageIntro.astro';
import { CATEGORY_META, sectionUrl, url } from '../lib/site';
import { heroOf } from '../lib/projectMedia';

/**
 * The full project page body. It used to be shared by every project's own URL and
 * by the research division page, which merged with its one project rather than
 * pointing at a one-item listing; the division pages are gone, so this now has
 * exactly one caller and no `introStill` prop to tell it which kind of page it is.
 *
 * Everything below the intro used to be credentials, demo/repo buttons, a "My
 * contribution" card, the MDX write-up, and a gallery — Kevin's call was to cut
 * all of that down to the facts rail and the prev/next nav, so the page is the
 * overview paragraph, what it was built with and when, and a way to the next
 * project. Nothing here reads the MDX body any more.
 *
 * Every project's accent (rules, markers) is the fixed structural Blue Dark —
 * there is no per-division accent.
 */
const FIGURE = {
  robotics: 'trajectory',
  research: 'contours',
  math: 'rays',
} as const;

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}

const { project, prev, next } = Astro.props;
const { data } = project;

/**
 * The picture at the top of the page, in the framing it was captured in — the
 * uncropped counterpart of the clip that played on the card the visitor hovered to
 * get here. A project with no footage falls through to its frontmatter poster, and
 * then to `MediaSlot`'s designed empty state.
 */
const hero = heroOf(project.id);

const meta = CATEGORY_META[data.category];

// Built with, then When, below it — in that order on every project. Team is
// dropped for robotics: those credit BrainStem as the repo owner, which reads
// as a team credit line the robotics blurb on the home page already carries,
// and Kevin's call was to cut it from the page itself. Research keeps it —
// AutoOMR's collaborator credit is the one team line that still belongs here.
const facts = [
  data.stack.length > 0 && { label: 'Built with', value: data.stack.join(', ') },
  data.period && { label: 'When', value: data.period },
  data.collaborative &&
    data.category !== 'robotics' && {
      label: 'Team',
      value: data.collaborative.owner,
      href: data.collaborative.ownerUrl,
    },
].filter(Boolean) as { label: string; value: string; href?: string }[];
---

<article>
  <PageIntro
    image={data.poster ?? null}
    still={hero}
    alt={hero?.alt ?? data.posterAlt ?? `${data.title} running`}
    caption={hero?.caption ?? null}
    title={data.title}
    overview={data.summary}
    eyebrow={{ label: meta.label, href: sectionUrl(data.category) }}
    figure={FIGURE[data.category]}
    backHref={sectionUrl(data.category)}
  />

  {
    (facts.length > 0 || data.sourceLost) && (
      <div class="wrap layout">
        {facts.length > 0 && (
          <dl class="facts">
            {facts.map((fact) => (
              <div class="facts__row">
                <dt class="label">{fact.label}</dt>
                <dd>
                  {fact.href ? (
                    <a href={fact.href} rel="noopener">
                      {fact.value}
                    </a>
                  ) : (
                    fact.value
                  )}
                </dd>
              </div>
            ))}
          </dl>
        )}

        {
          data.sourceLost && (
            <p class="lost">
              The source for this project was written on a school device and did not
              survive graduation.
            </p>
          )
        }
      </div>
    )
  }

  {
    (prev || next) && (
      <nav class="wrap neighbours" aria-label="Other projects">
        {prev ? (
          <a class="neighbour" href={url(`/projects/${prev.id}`)}>
            <span class="label">Previous in {CATEGORY_META[prev.data.category].label}</span>
            <span class="neighbour__title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a class="neighbour neighbour--next" href={url(`/projects/${next.id}`)}>
            <span class="label">Next in {CATEGORY_META[next.data.category].label}</span>
            <span class="neighbour__title">{next.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</article>

<style>
  /* ---- Facts --------------------------------------------------------------- */

  .layout {
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-6) var(--s-7);
    border-top: 1px solid var(--rule);
  }

  .facts dl {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 34rem) {
    .facts dl {
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      gap: var(--s-9);
    }
  }

  .facts__row dt {
    margin-bottom: var(--s-1);
  }

  .facts__row dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }

  .lost {
    color: var(--ink-tertiary);
    font-size: var(--text-sm);
    max-width: 56ch;
  }

  /* ---- Neighbours -------------------------------------------------------- */

  .neighbours {
    display: grid;
    gap: var(--s-4);
    padding-bottom: var(--section-y);
    border-top: 1px solid var(--rule);
    padding-top: var(--s-6);
  }

  @media (min-width: 46rem) {
    .neighbours {
      grid-template-columns: 1fr 1fr;
    }
  }

  .neighbour {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .neighbour:hover {
    border-color: var(--rule-strong);
    box-shadow: var(--shadow-sm);
  }

  .neighbour--next {
    text-align: right;
  }

  .neighbour__title {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: var(--track-tight);
  }
</style>
