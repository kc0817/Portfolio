---
/**
 * One drawn icon set, uniform 1.5px stroke on a 24-grid, currentColor only.
 * Unicode glyphs and emoji are not icons; anything the site needs is drawn here.
 */
interface Props {
  name:
    | 'play'
    | 'arrow-right'
    | 'arrow-left'
    | 'external'
    | 'github'
    | 'linkedin'
    | 'mail'
    | 'file'
    | 'image';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'play' && <path d="M8 5.5v13l11-6.5z" fill="currentColor" stroke="none" />}
  {
    name === 'arrow-right' && (
      <>
        <path d="M4 12h16" />
        <path d="M14 6l6 6-6 6" />
      </>
    )
  }
  {
    name === 'arrow-left' && (
      <>
        <path d="M20 12H4" />
        <path d="M10 18l-6-6 6-6" />
      </>
    )
  }
  {
    name === 'external' && (
      <>
        <path d="M14 4h6v6" />
        <path d="M20 4l-9 9" />
        <path d="M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4" />
      </>
    )
  }
  {
    name === 'github' && (
      <path
        d="M9 19c-4 1.4-4-2.1-6-2.6m12 5.2v-3.6a3.1 3.1 0 0 0-.9-2.4c2.9-.3 5.9-1.4 5.9-6.4a5 5 0 0 0-1.4-3.4 4.6 4.6 0 0 0-.1-3.5s-1.4-.4-4.5 1.7a11.3 11.3 0 0 0-6 0C4.9 1.9 3.5 2.3 3.5 2.3a4.6 4.6 0 0 0-.1 3.5A5 5 0 0 0 2 9.3c0 5 3 6.1 5.9 6.4a3.1 3.1 0 0 0-.9 2.4V21.6"
      />
    )
  }
  {
    name === 'linkedin' && (
      <>
        <path d="M16.5 8.5A5.5 5.5 0 0 1 22 14v6.5h-4V14a1.5 1.5 0 0 0-3 0v6.5h-4V9h4v1.6a5.4 5.4 0 0 1 1.5-2.1z" />
        <rect x="2" y="9" width="4" height="11.5" rx="0.5" />
        <circle cx="4" cy="4.5" r="2" />
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
        <path d="M3 6.5l9 6.5 9-6.5" />
      </>
    )
  }
  {
    name === 'file' && (
      <>
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
        <path d="M14 3v5h5" />
      </>
    )
  }
  {
    name === 'image' && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <circle cx="8.5" cy="9.5" r="1.75" />
        <path d="M21 16l-5.5-5.5a1.5 1.5 0 0 0-2.12 0L4 20" />
      </>
    )
  }
</svg>
