---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

const byId = new Map(projects.map((p) => [p.id, p]));

/**
 * Hand-arranged rather than weight-sorted: row one leads with the two
 * headline builds (cube, spider) at 3/4 width combined, raycaster fills the
 * smaller remainder. Row two flips the pattern — perlin (the smallest of the
 * three) leads at 1/4, physics engine and Kevmos take the rest. Columns are
 * an 8-wide grid so 3+3+2 and 2+3+3 both land on exact quarters.
 */
const LAYOUT = [
  { id: 'rubiks-cube-3d', span: 3 },
  { id: 'procedural-spider', span: 3 },
  { id: 'raycaster', span: 2 },
  { id: 'perlin-terrain', span: 2 },
  { id: 'physics-engine-2d', span: 3 },
  { id: 'graphing-calculator', span: 3 },
] as const;

const arranged = LAYOUT.map(({ id, span }) => ({ project: byId.get(id), span })).filter(
  (item): item is { project: CollectionEntry<'projects'>; span: (typeof LAYOUT)[number]['span'] } =>
    Boolean(item.project),
);

const arrangedIds = new Set(arranged.map((item) => item.project.id));
const rest = projects.filter((p) => !arrangedIds.has(p.id));
---

<div class="grid">
  {
    arranged.map(({ project, span }) => (
      <div class="grid__item" style={`grid-column: span ${span};`}>
        <ProjectCard project={project} />
      </div>
    ))
  }
  {
    rest.map((project) => (
      <div class="grid__item" style="grid-column: span 4;">
        <ProjectCard project={project} />
      </div>
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    /* Without this, grid's default stretch forces every card in a row to the
       same height — the row's tallest item, set by the wider span-3 cards'
       taller 4:3 media box. The narrower span-2 cards (raycaster, perlin)
       then had their own media box stay short but their text area stretched
       to fill the leftover height, sitting taller than the other four. Each
       card now sizes to its own content instead, so the media height still
       scales with the card's own width (as it should for a fixed aspect
       ratio) but the text area — fixed by the 3-line clamp — matches across
       every card regardless of column span. */
    align-items: start;
    gap: var(--s-6);
  }

  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .grid__item {
      grid-column: span 2 !important;
    }
  }

  @media (max-width: 30rem) {
    .grid {
      grid-template-columns: 1fr;
    }

    .grid__item {
      grid-column: span 1 !important;
    }
  }
</style>
