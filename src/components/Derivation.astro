---
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import DerivationBlocks from './DerivationBlocks.astro';
import Icon from './Icon.astro';
import Math from './Math.astro';
import { DERIVATION } from '../lib/ballisticDerivation';
import { url } from '../lib/site';
import shootingVariables from '../assets/robotics/shooting-variables-diagram.png';
import sotmDiagram from '../assets/robotics/sotm-diagram.png';
import velocityDrop from '../assets/robotics/velocity-drop-diagram.png';
import shooterControl from '../assets/robotics/shooter-control-diagram.png';
import turretControl from '../assets/robotics/turret-control-diagram.png';
import hoodControl from '../assets/robotics/hood-control-diagram.png';
import shooterSysId from '../assets/robotics/shooter-sysid.png';
import turretSysId from '../assets/robotics/turret-sysid.png';
import hoodSysId from '../assets/robotics/hood-sysid.png';

/**
 * The three steps of the solver, each one a heading, a paragraph saying what the
 * step is for, a picture of it, and — folded away — the algebra that does it.
 *
 * This replaced a Raw math / Conceptual tab pair. The tabs asked the visitor to
 * choose between two accounts of the same thing before they knew what either
 * said; a per-step disclosure asks nothing, because the prose is the page and the
 * math is an offer. That is the same layering PRODUCT.md calls for, moved from a
 * mode switch to progressive disclosure.
 *
 * `<details>` and not a scripted accordion, for the reason the tabs were a radio
 * group: with no JavaScript it still opens, and the summary already carries the
 * expanded/collapsed state a script would have to announce by hand. Collapsed by
 * default — most visitors are not here for the quartic.
 *
 * The steps are written out rather than mapped: each carries its own lead copy
 * with its own emphasis, and the shared part is the block rendering, which lives
 * in `DerivationBlocks`.
 */
const [step1, step2, step3] = DERIVATION;

/**
 * Step 3 in three disclosures instead of one, because it is the only step whose
 * algebra is three separable jobs — derive a polynomial, find its useful root,
 * substitute that root back — and one fold over all of it asks the reader to
 * commit to the whole grind or none of it.
 *
 * The boundaries are found by heading rather than written as literal indices, so
 * inserting a line into a section cannot silently move the section break to the
 * wrong place. A rename can still break it, which is what the throw is for: the
 * split is structural, and a page that quietly renders the wrong three groups is
 * worse than a build that stops.
 */
const ROOTS_HEAD = 'Finding zeroes of time of flight polynomial';
const ANGLES_HEAD = 'Plugging the time of flight into the launch vector equations';

const headIndex = (text: string) => {
  const i = step3.blocks.findIndex((b) => b.kind === 'sub' && b.text === text);
  if (i === -1) {
    throw new Error(
      `Derivation: step 3 has no sub-heading "${text}", so its disclosures cannot be split. ` +
        'Update the constant in Derivation.astro to match the heading in ballisticDerivation.ts.'
    );
  }
  return i;
};

const iRoots = headIndex(ROOTS_HEAD);
const iAngles = headIndex(ANGLES_HEAD);

const STEP3 = {
  /* a — the symbols beside the plot, then everything up to the quartic. */
  declared: step3.blocks.slice(0, 4),
  polynomial: step3.blocks.slice(4, iRoots),
  /* b — approximating the root and choosing between the arcs it offers. */
  roots: step3.blocks.slice(iRoots, iAngles),
  /* c — the chosen flight time put back through the launch vector. */
  angles: step3.blocks.slice(iAngles),
};

/**
 * The two clips, as encoded. Both are silent — the audio track is stripped, not
 * muted — and neither plays on its own: they carry `controls` and no autoplay,
 * which is why they are written out here rather than going through `MediaSlot`
 * (every mode that component offers starts playback for you).
 *
 * The dimensions are the encode's own, and they are here because the pair below
 * sizes itself from aspect ratio.
 */
const CLIPS = {
  basicShot: {
    src: url('/media/ballistic-basic-shot.mp4'),
    poster: url('/media/ballistic-basic-shot.jpg'),
    width: 1280,
    height: 800,
  },
  sotm: {
    src: url('/media/ballistic-sotm.mp4'),
    poster: url('/media/ballistic-sotm.jpg'),
    width: 960,
    height: 648,
  },
  hood: {
    src: url('/media/ballistic-hood-compensation.mp4'),
    poster: url('/media/ballistic-hood-compensation.jpg'),
    width: 720,
    height: 900,
  },
  /* The odd width is the screen recording's own — the sim window, uncropped. This
     one is the exception to the note above: it still carries its capture's audio
     track. Nothing autoplays, so it stays silent until asked. */
  sim: {
    src: url('/media/ballistic-advantagescope-sim.mp4'),
    width: 1954,
    height: 938,
  },
};

/**
 * Step 5's three mechanisms. Unlike the steps above — each of which carries its
 * own shape and so is written out — these three are the same panel three times
 * over: a control-system column and a system-identification column, in that
 * order. So the copy is data and the markup is written once, which is also what
 * guarantees the layout cannot shift between selections.
 *
 * TODO(Kevin): every `control` and `sysId` string below is scaffolding. Replace
 * each paragraph with what that mechanism actually runs — the loop, what it runs
 * on, what it holds against. Both figures in all three panels are the real
 * pictures now: the block diagram on the left, the fit the constants came out of
 * on the right.
 */
/**
 * A control-system column is either one paragraph or a run of these: a paragraph,
 * a display equation, or the symbol key that captions one. Written as a type so
 * the array literal below does not widen into a single optional-everything shape,
 * which is what makes `'eq' in part` a real narrowing in the markup.
 */
type ControlPart = string | { eq: string } | { note: string };

const SUBSYSTEMS: {
  id: string;
  label: string;
  diagram: ImageMetadata;
  diagramAlt: string;
  sysIdImage: ImageMetadata;
  sysIdAlt: string;
  control: string | ControlPart[];
  sysId: string;
}[] = [
  {
    id: 'shooter',
    label: 'Shooter',
    diagram: shooterControl,
    diagramAlt:
      'Block diagram of the shooter control system. Launch velocity in metres per ' +
      'second converts to a motor velocity in ticks per second, which splits into a ' +
      'velocity-and-friction feedforward and a gain-scheduled PID; the two sum into ' +
      'a voltage for the shooter motors, whose encoder feeds back through a low-pass ' +
      'filter into the PID.',
    sysIdImage: shooterSysId,
    sysIdAlt:
      'A Desmos logarithmic regression of ball exit speed against commanded motor ' +
      'velocity. Roughly fifty logged shots cluster in vertical stacks at each swept ' +
      'velocity from 400 up to 1000 ticks per second, with exit speeds from about 3 ' +
      'to 8.5 metres per second. The fit is y = −27.32 + 5.133·ln(x), R² = 0.9365.',
    control:
      'Like all good things, I started with a PID. Then, to counteract the backEMF ' +
      'and friction in the motor, I added a feedforward velocity regression. And to ' +
      'communicate with the physics algorithm, I modeled a launch velocity to motor ' +
      'velocity conversion (see right). I also applied a ' +
      'time-invariant low pass filter to remove high frequency sensor noise.',
    sysId:
      'This regression relates a given motor velocity (x axis) to the ball’s launch ' +
      'velocity (y axis). Interestingly, a logarithmic curve best fit this data, ' +
      'showing that at higher speeds, more energy is lost in the shooter wheel-ball ' +
      'collision.',
  },
  {
    id: 'turret',
    label: 'Turret',
    diagram: turretControl,
    diagramAlt:
      'Block diagram of the turret control system. Target angle runs through a ' +
      'trapezoidal motion profile into a velocity-and-friction feedforward, and ' +
      'separately into a clamped PID; robot acceleration drives an external-torque ' +
      'mitigation term. All three sum into a voltage for the turret motor, whose ' +
      'encoder feeds back into the PID.',
    sysIdImage: turretSysId,
    sysIdAlt:
      'A Desmos linear regression from the turret velocity sweep: five measured ' +
      'points rising steadily from (0.6, 2) to (2.5, 4), fitted by ' +
      'y = 1.0788x + 1.317 with R² = 0.9925.',
    /* The one panel whose copy is not a single paragraph: it carries two equations
       and a symbol list, so it is written as parts rather than as a string. */
    control: [
      'Similarly to the shooter, I also started with just a PID. Then I added a ' +
        'distance-based trapezoidal motion profiler using this equation:',
      { eq: 'v_f^2 - v_i^2 = 2ad' },
      'The output of the motion profiler is fed into a feedforward velocity ' +
        'regression, similar to that in the shooter (see right). And finally, because ' +
        'the shooter’s center of mass is not ' +
        'aligned with the turret’s axis of rotation, any robot acceleration will exert ' +
        'a torque on the turret. So I countered the external torque with this physics ' +
        'model:',
      { eq: 'V \\mathrel{-}= k_T \\left( \\vec{a}_{\\text{robot}} \\times \\vec{r}_{\\text{turret}} \\right)' },
      {
        /* `$...$` spans are typeset, the same convention the derivation's own prose
           blocks use — so the symbols in the key are the glyphs from the equation
           above it rather than ASCII approximations of them. */
        note:
          '$V$ = applied voltage, $k_T$ = a tunable constant, ' +
          '$\\vec{a}_{\\text{robot}}$ = robot acceleration, ' +
          '$\\vec{r}_{\\text{turret}}$ = turret axis relative to robot axis',
      },
    ],
    sysId:
      'Below is the feedforward turret velocity regression. The x axis is angular ' +
      'velocity (rad/s), and the y axis is applied voltage. The slope corresponds to ' +
      'kV and intercept corresponds to kS.',
  },
  {
    id: 'hood',
    label: 'Hood',
    diagram: hoodControl,
    diagramAlt:
      'Block diagram of the hood control system. Target angle feeds a gravity ' +
      'feedforward and a PID in parallel; the two sum into a voltage for the hood ' +
      'servos, whose encoder feeds back into the PID.',
    sysIdImage: hoodSysId,
    sysIdAlt:
      'A Desmos linear regression tying the hood’s encoder reading to its measured ' +
      'angle: five points falling from (518, 71 degrees) to (614, 35 degrees), fitted ' +
      'by y = −0.3738x + 263.75 with R² = 0.9973.',
    control: [
      'The hood control system is pretty simple; a PID with gravity feedforward modeled by',
      /* `\mathrel{{+}{=}}` and not `\mathrel{+}=`: the braced group makes the two
         glyphs one relation, so they set tight as the `+=` operator rather than
         with relation spacing opening a gap between them. */
      { eq: String.raw`V \mathrel{{+}{=}} k_G \cos\theta` },
      {
        note:
          '$V$ = applied voltage, $k_G$ = tunable constant, ' +
          '$\\theta$ = hood angle from horizontal',
      },
    ],
    sysId:
      'This regression maps hood encoder values to the actual angle from the ' +
      'horizontal. The x axis is encoders, and the y axis is angle (degrees).',
  },
];
---

<div class="wrap deriv">
  {/* ---- 1 --------------------------------------------------------------- */}
  <section class="step">
    <div class="step__row">
      <div class="step__text">
        <h2 class="step__title">
          <span class="step__n">{step1.n}</span>
          {step1.title}
        </h2>

        <p class="step__lead">
          The parabolic curve of a projectile can be defined with 3 data points: a
          starting position, an ending position, and the angle of its velocity
          vector when at the ending position (this is a tunable constant which I
          call the impact angle).{' '}
          Using these 3 pieces of data, one can calculate the launch vector of the
          ball at any given robot position.
        </p>
      </div>

      <figure class="step__figure">
        <video
          class="step__video"
          src={CLIPS.basicShot.src}
          poster={CLIPS.basicShot.poster}
          width={CLIPS.basicShot.width}
          height={CLIPS.basicShot.height}
          aria-label="The robot on the practice field firing a ball into the red goal from a standstill."
          controls
          playsinline
          preload="metadata"
          disablepictureinpicture></video>
      </figure>
    </div>

    <details class="fold">
      <summary class="fold__summary">
        {/* The class is on a wrapper, not on `Icon` itself: a scoped style in
            this file cannot reach the root element of a child component. */}
        <span class="fold__chevron"><Icon name="chevron-right" size={18} /></span>
        <span class="fold__label fold__label--shut">Show the math</span>
        <span class="fold__label fold__label--open">Hide the math</span>
      </summary>
      {/* The diagram lives in here, beside the list of what each symbol means,
          rather than out in the media column: it is a key to the variables the
          algebra uses, so it is only of use to a reader who has opened the
          algebra. Folding it away with them is the honest pairing. */}
      <div class="fold__body">
        <div class="decl">
          <div class="decl__text">
            <DerivationBlocks blocks={step1.blocks.slice(0, 1)} />
          </div>
          <figure class="decl__figure">
            <Image
              src={shootingVariables}
              alt="A side view of the shooter on the robot with the trajectory drawn as an arc to the goal. The exit velocity v leaves at hood angle θ above horizontal, the turret angle φ opens off the robot's heading across the horizontal distance d, and the impact angle i is marked at the ball where it meets the goal."
              widths={[448, 896]}
              sizes="(min-width: 52rem) 28rem, 90vw"
              class="step__img step__img--plate"
            />
          </figure>
        </div>
        <div class="fold__math">
          <DerivationBlocks blocks={step1.blocks.slice(1)} />
        </div>
      </div>
    </details>
  </section>

  {/* ---- 2 --------------------------------------------------------------- */}
  <section class="step">
    <div class="step__row step__row--flip">
      <div class="step__text">
        <h2 class="step__title">
          <span class="step__n">{step2.n}</span>
          {step2.title}
        </h2>

        <p class="step__lead">
          We also need a way to counteract the robot’s movement, because it will
          alter the trajectory of the ball. To do this, we can use vector
          subtraction and offset the previous 3D launch vector by the velocity at
          the ball’s exit position. Note: because the ball’s launch position is not
          guaranteed to be aligned with the robot’s axis of rotation, we also need
          to account for the tangential velocity created by rotation.
        </p>
      </div>

      <figure class="step__figure">
        <video
          class="step__video"
          src={CLIPS.sotm.src}
          poster={CLIPS.sotm.poster}
          width={CLIPS.sotm.width}
          height={CLIPS.sotm.height}
          aria-label="The robot driving across the practice field while shooting at the goal, without stopping to line up."
          controls
          playsinline
          preload="metadata"
          disablepictureinpicture></video>
      </figure>
    </div>

    <details class="fold">
      <summary class="fold__summary">
        {/* The class is on a wrapper, not on `Icon` itself: a scoped style in
            this file cannot reach the root element of a child component. */}
        <span class="fold__chevron"><Icon name="chevron-right" size={18} /></span>
        <span class="fold__label fold__label--shut">Show the math</span>
        <span class="fold__label fold__label--open">Hide the math</span>
      </summary>
      <div class="fold__body">
        {/* All of step 2 runs beside the diagram, not just its symbol list: the
            whole step is a definition, a cross product, and a two-line vector
            subtraction — narrow enough to sit in the text column, and short enough
            that putting only the symbols up here left the diagram's own height as
            an empty gap with the algebra pushed below it. */}
        <div class="decl">
          <div class="decl__text">
            <DerivationBlocks blocks={step2.blocks} />
          </div>
          <figure class="decl__figure">
            <Image
              src={sotmDiagram}
              alt="A 3D vector diagram. The blue vector V_ball is the launch vector the ball needs; the red vector V_robot is the robot's own velocity along the floor, and its negative is added to the tip of V_ball; the purple vector V_adjusted is the result the shooter is actually commanded to."
              widths={[448, 610]}
              sizes="(min-width: 52rem) 28rem, 90vw"
              class="step__img step__img--plate"
            />
          </figure>
        </div>
      </div>
    </details>
  </section>

  {/* ---- 3 --------------------------------------------------------------- */}
  <section class="step">
    <div class="step__row">
      <div class="step__text">
        <h2 class="step__title">
          <span class="step__n">{step3.n}</span>
          {step3.title}
        </h2>

        <p class="step__lead">
          The Law of Conservation of Energy states that energy cannot be created.
          Therefore, when the shooter contacts the ball and the ball speeds up, the
          shooter wheel must slow down. Since the shooter wheel has lost some of its
          energy, it will transfer less energy to the <em>next</em> ball that is
          shot, decreasing shot accuracy.
        </p>
        <p class="step__lead">
          To mitigate this problem, we can alter our hood angle — changing the arc
          of the trajectory — to compensate for the lower exit speed; and we can
          also alter our turret angle to ensure that we can still shoot on the move.
        </p>
      </div>

      <figure class="step__figure step__figure--portrait">
        <video
          class="step__video"
          src={CLIPS.hood.src}
          poster={CLIPS.hood.poster}
          width={CLIPS.hood.width}
          height={CLIPS.hood.height}
          aria-label="The robot firing a burst of shots at the goal while the hood adjusts between them."
          controls
          playsinline
          preload="metadata"
          disablepictureinpicture></video>
      </figure>
    </div>

    {/* Three disclosures rather than one, each naming its own job. Steps 1 and 2
        say "Show the math" because there is one thing behind the fold and the
        summary only has to offer it; here the summary has to say which third of the
        grind it opens, so the label is the section title and the chevron carries the
        state on its own. */}
    <details class="fold">
      <summary class="fold__summary">
        {/* The class is on a wrapper, not on `Icon` itself: a scoped style in
            this file cannot reach the root element of a child component. */}
        <span class="fold__chevron"><Icon name="chevron-right" size={18} /></span>
        <span class="fold__label">a: Deriving time of flight polynomial</span>
      </summary>
      <div class="fold__body">
        {/* Step 3 cannot give the diagram all of its algebra the way step 2 does —
            the component table and the S² expansion below need the full measure —
            so the split is at the last narrow block: the symbols, the line that
            introduces them, and the vector identity all run up beside the plot,
            which is about its height, and the wide work starts under it. */}
        <div class="decl">
          <div class="decl__text">
            <DerivationBlocks blocks={STEP3.declared} />
          </div>
          <figure class="decl__figure">
            <Image
              src={velocityDrop}
              alt="A telemetry plot of shooter wheel velocity over time. Three shots are marked as shaded bands; the wheel is running steadily before the first, and a labelled velocity drop takes it well below that level across the three shots before it recovers."
              widths={[448, 721]}
              sizes="(min-width: 52rem) 28rem, 90vw"
              class="step__img step__img--plate"
            />
          </figure>
        </div>
        {/* Uncapped, because the S² expansion is the widest equation on the page and
            at 54rem it was the one strip on a desktop that still had to scroll. The
            page's own measure is the only cap it gets. */}
        <div class="fold__math fold__math--wide">
          <DerivationBlocks blocks={STEP3.polynomial} />
        </div>
      </div>
    </details>

    <details class="fold">
      <summary class="fold__summary">
        <span class="fold__chevron"><Icon name="chevron-right" size={18} /></span>
        <span class="fold__label">b: Approximating the “best” flight time</span>
      </summary>
      <div class="fold__body">
        <div class="fold__math fold__math--wide fold__math--wide-prose">
          <DerivationBlocks blocks={STEP3.roots} />
        </div>
      </div>
    </details>

    <details class="fold">
      <summary class="fold__summary">
        <span class="fold__chevron"><Icon name="chevron-right" size={18} /></span>
        <span class="fold__label">c: Calculating compensated hood and turret angles</span>
      </summary>
      <div class="fold__body">
        <div class="fold__math">
          <DerivationBlocks blocks={STEP3.angles} />
        </div>
      </div>
    </details>
  </section>

  {/* ---- 4 --------------------------------------------------------------- */}
  {/* No disclosure on this one: the simulator is a tool the solver was tested
      in, not another leg of the derivation, so there is no algebra to fold. */}
  <section class="step">
    <div class="step__row step__row--flip">
      <div class="step__text">
        <h2 class="step__title">
          <span class="step__n">4</span>
          Custom AdvantageScope Sim
        </h2>

        <p class="step__lead">
          The purpose of this simulation is to visualize 3D poses and trajectories,
          allowing me to extensively test my physics equations as well as robot
          behavior before deploying to the robot.
        </p>

        <ul class="step__list">
          <li>
            To visualize the shot arcs, I converted the launch vector into a
            parabolic equation, then generated points along the equation and drew
            lines connecting them.
          </li>
          <li>
            To model the balls, I implemented Euler’s method and applied gravity to
            simulate a projectile.
          </li>
        </ul>
      </div>

      <figure class="step__figure">
        <video
          class="step__video step__video--crop-right"
          src={CLIPS.sim.src}
          width={CLIPS.sim.width}
          height={CLIPS.sim.height}
          aria-label="The AdvantageScope simulation drawing the solver's shot arc and a ball flying along it into the goal."
          controls
          playsinline
          preload="metadata"
          disablepictureinpicture></video>
      </figure>
    </div>
  </section>

  {/* ---- 5 --------------------------------------------------------------- */}
  {/* The one step laid out full width rather than prose-beside-media: it is not
      one argument with one picture, it is the same pair of columns read three
      times over, and the picker is the thing that has to be read across the
      whole measure. */}
  <section class="step">
    <h2 class="step__title">
      <span class="step__n">5</span>
      Control System Design &amp; Testing
    </h2>

    <p class="step__lead step__lead--full">
      For both FTC and FRC, our shooting system consists of 3 hardware components
      allowing us to accurately launch balls.
    </p>

    <div class="subsys">
      {/* A radio group and not scripted tabs, for the same reason the disclosures
          above are `<details>`: with no JavaScript the picker still works, the
          checked state is the control's own rather than something a script has to
          keep in sync, and arrow-key navigation between the three comes free. */}
      <fieldset class="subsys__pick">
        <legend class="visually-hidden">Choose a mechanism</legend>
        {
          SUBSYSTEMS.map((sub, i) => (
            <label class="pick">
              <input type="radio" name="subsystem" value={sub.id} checked={i === 0} />
              {sub.label}
            </label>
          ))
        }
      </fieldset>

      {
        SUBSYSTEMS.map((sub) => (
          <div class="panel" data-subsys={sub.id}>
            <div class="panel__col">
              <h3 class="panel__title">Control System</h3>
              {/* A panel's control copy is either one paragraph or a run of parts —
                  paragraphs, display equations, and a symbol key. One string is
                  normalised to a one-part run so the markup has a single shape. */}
              {(Array.isArray(sub.control) ? sub.control : [sub.control]).map((part) =>
                typeof part === 'string' ? (
                  <p class="panel__body">{part}</p>
                ) : 'eq' in part ? (
                  <div class="panel__eq">
                    <Math tex={part.eq} display />
                  </div>
                ) : (
                  <p class="panel__body panel__note">
                    {part.note
                      .split('$')
                      .map((piece, i) => (i % 2 === 1 ? <Math tex={piece} /> : piece))}
                  </p>
                )
              )}
              {/* The block diagrams are drawn on white, so they take the same
                  hairline plate the step diagrams above do. Half the measure at
                  the wide layout, full at the narrow one. */}
              <figure class="panel__figure">
                <Image
                  src={sub.diagram}
                  alt={sub.diagramAlt}
                  widths={[440, 880]}
                  sizes="(min-width: 52rem) 27rem, 90vw"
                  class="step__img step__img--plate"
                />
              </figure>
            </div>

            <div class="panel__col">
              <h3 class="panel__title">System Identification</h3>
              <p class="panel__body">{sub.sysId}</p>
              {/* The regressions are screenshots off a white Desmos ground, so they
                  take the same hairline plate the block diagrams do. */}
              <figure class="panel__figure">
                <Image
                  src={sub.sysIdImage}
                  alt={sub.sysIdAlt}
                  widths={[440, 880]}
                  sizes="(min-width: 52rem) 27rem, 90vw"
                  class="step__img step__img--plate"
                />
              </figure>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</div>

<style>
  .deriv {
    padding-block: var(--s-7) var(--s-8);
    border-top: 1px solid var(--rule);
    display: grid;
    gap: var(--s-8);
  }

  /* ---- A step ------------------------------------------------------------ */

  .step + .step {
    padding-top: var(--s-7);
    border-top: 1px solid var(--rule);
  }

  /* Text left, pictures right — the same split the Overview above uses, so the
     page reads as one column of prose with one column of pictures beside it
     rather than as two differently laid-out sections. */
  .step__row {
    display: grid;
    gap: var(--s-6);
  }

  @media (min-width: 52rem) {
