---
import MediaSlot from './MediaSlot.astro';
import { MARQUEE } from '../lib/projectMedia';
import { SITE } from '../lib/site';

/**
 * The offcuts. The portfolio above is three projects because Kevin cut it to three;
 * this section is where the page admits that, points at the two places the rest
 * actually lives, and shows a strip of it going past.
 *
 * The strip is a marquee rather than a carousel with controls, and that is a decision
 * about what it is for. Controls imply the contents are worth navigating, item by
 * item, which would be a promise this section explicitly does not make — the two
 * links are the destinations. A strip that drifts reads as "there is more of this",
 * which is the whole message, and it needs no chrome to say it.
 *
 * Square tiles, deliberately unlike the 4:3 project cards above: a different shape is
 * what stops seven thumbnails reading as a fourth row of projects.
 *
 * Each tile's name is hidden until it is pointed at, then fades in below it. Showing
 * all seven at rest would turn the strip into a list, which is the one thing this
 * section promises not to be — but a strip that pauses under the pointer and plays the
 * clip has already invited a closer look, and at that moment "what is this?" is the
 * obvious next question. So the name arrives exactly when it is asked for.
 */
const ITCH = 'https://kc0817.itch.io/';

/**
 * The track is rendered twice. One copy translated by -50% of the whole list lands
 * exactly where the other began, so the loop needs no JavaScript holding position.
 *
 * Both copies are `<li>`s of one `<ul>` rather than two separate lists. That started
 * out load-bearing — a hover effect used sibling selectors to move the tiles either
 * side of the pointed-at one, and those cannot reach across two lists — and the effect
 * is gone now. The single list stays because it is simply less markup for the same
 * result: fourteen items and no wrapper, against two lists whose seam has to be
 * measured either way.
 *
 * Duplicates carry `aria-hidden` individually, so a screen reader hears seven tiles
 * rather than fourteen.
 */
const TRACK = [0, 1].flatMap((copy) =>
  MARQUEE.map((item, i) => ({ item, copy, key: `${copy}-${i}` })),
);
---

<section class="more" id="more" aria-labelledby="more-heading">
  <div class="wrap more__head" data-rise>
    <h2 id="more-heading">Explore More</h2>
    <p class="more__note">
      To keep a concise portfolio, I didn&rsquo;t show a lot of the more random, smaller
      projects I&rsquo;ve done. If you&rsquo;re interested, a full list can be viewed in my{' '}
      <a href={SITE.github} rel="noopener">Github</a>, and you can find a lot more demos
      at my <a href={ITCH} rel="noopener">itch.io dashboard</a>.
    </p>
  </div>

  {/*
    Full-bleed rather than inside `.wrap`: a strip that starts and stops at the page
    gutter reads as a bounded widget, and the point of this one is that it continues
    past the edge of what you can see.

    `--marquee-n` carries the count into the stylesheet, because the track's width and
    therefore the duration both derive from it — a tile added or removed should not
    need a number changed in two places.
  */}
  <div
    class="marquee"
    style={`--marquee-n: ${MARQUEE.length}`}
    role="group"
    aria-label="A sample of smaller projects"
  >
    <ul class="marquee__track">
      {
        TRACK.map(({ item, copy }) => (
          /* `data-video-hover-root` is what MediaSlot's hover script looks for when
             the clip is not inside a link — it binds play/pause to this element, so
             pointing at the tile (not the video buried under it) is what starts it.

             It sits on the whole item rather than on the square, which means the label
             is inside the hover region too. That is deliberate: a label that appeared
             under the cursor and then had to be un-hovered to keep would be a trap,
             and pointing at a thing's name is pointing at the thing. */
          <li
            class="marquee__item"
            aria-hidden={copy === 1 ? 'true' : undefined}
            data-video-hover-root
          >
            <div class="marquee__tile">
              <MediaSlot
                video={item?.src && item.poster ? { src: item.src, poster: item.poster } : null}
                image={item && !item.src && item.poster ? item.poster : null}
                playOn="hover"
                preload="none"
                alt={item?.alt ?? ''}
                iconSize={26}
              />
            </div>
            {/* Rendered even for an empty slot, so every item reserves the same
                height and filling a `null` later cannot change the strip's size. */}
            <p class="marquee__label">{item?.title ?? ''}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  /**
   * Halves the drift's speed while the pointer is over the strip.
   *
   * This is script rather than a `:hover` rule for the reason spelled out beside
   * the `focus-within` pause below: CSS can only offer `animation-duration`, and
   * changing that mid-flight rescales the animation's progress along with it, so
   * the strip lurches backwards at the moment of hover. `playbackRate` scales the
   * rate the animation advances at and leaves its current time alone, which is
   * the difference between slowing something down and rewinding it.
   *
   * The animation is looked up on each event rather than captured once, so the
   * reduced-motion branch cancelling it — at load or by the user changing the
   * preference with the page already open — simply yields nothing to slow, and
   * this quietly does nothing instead of holding a stale handle.
   */
  const SLOW = 0.5;

  /* Identified by having no end rather than by name. The drift is the only
     animation on the track that runs forever, so the test is exact, and it stays
     exact without depending on `marquee-drift` surviving as a literal string —
     neither through renaming the keyframes here nor through whatever the scoped
     style pipeline decides to call them. */
  const driftOf = (track: HTMLElement) =>
    track.getAnimations().filter((a) => a.effect?.getTiming().iterations === Infinity);

  document.querySelectorAll<HTMLElement>('.marquee').forEach((marquee) => {
    const track = marquee.querySelector<HTMLElement>('.marquee__track');
    if (!track) return;

    const rate = (value: number) => () => {
      driftOf(track).forEach((drift) => {
        drift.playbackRate = value;
      });
    };

    /* `pointerenter`/`pointerleave` for the same reason MediaSlot uses them: they
       do not fire for movement between the tiles inside, so crossing a gap in the
       row cannot make the strip stutter back to full speed. */
    marquee.addEventListener('pointerenter', rate(SLOW));
    marquee.addEventListener('pointerleave', rate(1));
  });
</script>

<style>
  .more {
    padding-block: var(--section-y);
  }

  .more__head {
    display: grid;
    gap: var(--s-4);
  }

  .more__note {
    color: var(--ink-secondary);
    max-width: 68ch;
  }

  /* ---- Marquee --------------------------------------------------------- */

  .marquee {
    --tile-w: clamp(8.5rem, 18vw, 13rem);
    --tile-gap: var(--s-5);

    /* Duration from distance, not a taste value: one full cycle travels the width of
       one copy of the set, so a fixed seconds-per-tile keeps the drift at the same
       speed whatever the tile count or tile width works out to. 7s per tile is slow
       enough to read a thumbnail in passing and not so slow that the strip looks
       stalled. */
    --marquee-dur: calc(var(--marquee-n) * 7s);

    margin-top: var(--s-7);

    /* `clip` rather than `hidden`: `overflow: hidden` on an ancestor makes the
       sticky header stop sticking, and this is a full-bleed block on the same page.
       Only the inline axis is clipped, so nothing shortens the row's own height. */
    overflow-x: clip;

    /* The strip runs edge to edge, so the fade below is what ends it rather than the
       page gutter. */
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black var(--gutter),
      black calc(100% - var(--gutter)),
      transparent 100%
    );
  }

  .marquee__track {
    display: flex;
    gap: var(--tile-gap);
    /* Top-aligned, not stretched: the label below a tile is free to wrap to a second
       line without any tile in the row moving to accommodate it. */
    align-items: flex-start;
    /* Two copies side by side, so translating by half the list's width puts the
       second copy exactly where the first began. The trailing padding is load-bearing:
       fourteen tiles have thirteen gaps between them, and without a fourteenth the
       halfway point would land half a gap short and the loop would visibly jump. */
    padding: 0;
    padding-inline-end: var(--tile-gap);
    margin: 0;
    list-style: none;
    width: max-content;
    animation: marquee-drift var(--marquee-dur, 60s) linear infinite;
  }

  /* ---- Tile ------------------------------------------------------------ */

  /* The item is the square plus the space its label occupies. The width is set here
     rather than on the square so that a label can never be wider than the tile it
     names — it wraps inside the column instead of pushing the row apart. */
  .marquee__item {
    flex: none;
    width: var(--tile-w);
  }

  /* The tile is a fixed square and stays one, at rest and on hover alike. It briefly
     grew and widened to 16/9 under the pointer, with its neighbours parting to make
     room; that was cut deliberately. The strip's whole job is to say "there is more of
     this" and then get out of the way of the two links above it, and a tile that
     rearranges the row around itself was doing more work than the message needs.
     What answers the pointer now is the drift stopping, the clip starting, and the
     label arriving — all three of which are the content responding, not the layout. */
  .marquee__tile {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  /* ---- Hover label ----------------------------------------------------- */

  /* Present in the layout at all times and only ever invisible, so the strip has one
     height and pointing at a tile cannot move the tile next to it. `min-height` is
     what an empty slot's label contributes; a real one that wraps simply grows past
     it, and the top-aligned row absorbs that.
     Secondary ink and a small size, because this is a name for something being looked
     at rather than a caption to read — the picture is still the content. */
  .marquee__label {
    margin: var(--s-3) 0 0;
    min-height: 1.35em;
    font-size: var(--text-sm);
    line-height: 1.35;
    text-align: center;
    text-wrap: balance;
    color: var(--ink-secondary);
    opacity: 0;
    /* The resting value is the exit timing: a label released fades out faster than it
       arrived, so leaving a tile reads as a release rather than a second decision.
       Opacity alone — nothing about the item's box changes, which is what keeps a
       paused strip perfectly still while the name appears in it. */
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .marquee__item:hover .marquee__label,
  .marquee__item:focus-within .marquee__label {
    opacity: 1;
    transition-duration: var(--dur-mid);
  }

  @keyframes marquee-drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      /* Exactly one copy's width, which is half the doubled list. */
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* The drift no longer stops under the pointer — a hovered tile still plays its
     clip and fades in its label, but the strip keeps moving under it rather than
     holding still. It does halve its speed, and that is done from the script
     below rather than here: a `:hover` rule that doubled `animation-duration`
     would be the obvious CSS for it and is the one thing that cannot work.
     Duration is not speed. A running animation's progress is its elapsed time
     over its duration, so doubling the duration at the moment the pointer
     arrives halves the progress with it, and the strip snaps backwards by up to
     half its travel — then snaps forward again on the way out. `playbackRate`
     is the property that means what this wants: it changes how fast the clock
     runs without touching where the clock has got to.

     `focus-within` below keeps the harder pause for keyboard focus, since a
     tabbed-to tile has no pointer to keep the drift going for it and freezing the
     strip is the only way its clip and label get a chance to be seen at all. */
  .marquee:focus-within .marquee__track {
    animation-play-state: paused;
  }

  /* The global reduced-motion rule collapses *durations*, which for an infinite
     linear loop would mean an unreadable blur rather than stillness — so the drift has
     to be cancelled outright. The strip becomes a static row that overflows the
     viewport, which is a fine thing for it to be: the two links above are how the
     section is actually used, and no content lives only in here.
     Nothing else needs a reduced-motion branch. The clips stay parked on their
     posters, since MediaSlot declines to play at all under this preference, and the
     hover label's fade is the one case the global duration collapse handles correctly
     on its own — a cross-fade with no duration is just the label appearing, which is
     the whole of what it was ever doing. */
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
