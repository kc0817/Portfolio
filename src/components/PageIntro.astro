---
import type { ImageMetadata } from 'astro';
import MediaSlot from './MediaSlot.astro';
import Marginalia from './Marginalia.astro';
import Icon from './Icon.astro';
import type { Still } from '../lib/projectMedia';

/**
 * The first thing on a project page: a contained photo (never full-bleed — the
 * point is a framed picture, not another hero), the title, then an Overview
 * paragraph. It used to open the division pages too, which is why the props are
 * written as a general opening rather than as a project's opening; the division
 * pages are gone, but nothing here is specific to a project either, so the shape
 * has been left alone.
 */
interface Props {
  image: ImageMetadata | null;
  /**
   * A still that lives in `public/` rather than the asset pipeline — the project
   * clip's poster, which is frame 0 of that clip. This slot shows the picture and
   * nothing else: the clip belongs to the card the visitor hovered to get here,
   * where motion answers attention instead of demanding it on arrival.
   *
   * Its real pixel dimensions come with it so the frame can take the picture's
   * own aspect ratio — a fixed 16/10 frame would crop anything that is not
   * already 16/10 — and `content` says where the picture actually sits inside
   * those dimensions, since these encodes carry black bars.
   */
  still?: Still | null;
  alt: string;
  /**
   * What the picture above is, in the visitor's terms — captioned under it, not
   * hidden in `alt`. A demo still is one frame of a running program, so what it
   * shows is worth saying; a plain poster from frontmatter is a picture of the
   * thing the page is already titled after, and takes no caption.
   */
  caption?: string | null;
  title: string;
  eyebrow?: { label: string; href: string };
  figure?: 'rays' | 'linkage' | 'trajectory' | 'contours' | 'spline' | 'cube';
  /**
   * Built with / When / Team, directly under the title. The Overview paragraph
   * used to sit between the two; it is now its own section below this component,
   * so the facts and whatever the default slot carries close the intro.
   */
  facts?: { label: string; value: string; href?: string }[];
  /**
   * The prev/next project, one either side of the main image. Each is a
   * project's own title unless there is no neighbour on that side, in which case
   * the caller passes the division's anchor and a "Portfolio" label instead — so
   * the first project's left arrow and the last project's right arrow lead back
   * out rather than dead-ending. These are also the only way back to the
   * portfolio from the top of the page: the "Return to Portfolio" link that used
   * to sit above the picture is gone, and the eyebrow above the title still
   * links to the division.
   */
  prevNav: { label: string; href: string };
  nextNav: { label: string; href: string };
}

const {
  image,
  still = null,
  alt,
  caption = null,
  title,
  eyebrow,
  figure,
  facts = [],
  prevNav,
  nextNav,
} = Astro.props;

/**
 * The frame takes the picture's own aspect ratio, so nothing in this slot is
 * ever cropped: the `still` carries its dimensions, and an `image` from the
 * asset pipeline already knows its own. A picture taller than it is wide would
 * otherwise push the title off the first screen, so the frame is capped by
 * height and gives up width to stay under the cap — `--media-ratio` is what
 * lets the CSS trade one for the other. A 16/9 picture is limited by the 46rem
 * column and never reaches the cap; a square one narrows to about 30rem and
 * sits centred.
 *
 * When the still declares a `content` box smaller than the file, the aspect
 * that matters is the picture's, not the encode's: the black bars around it are
 * baked into the file, and the frame should be the shape of what is worth
 * looking at. `--crop-*` then scales the image so the content box exactly fills
 * that frame and offsets it so the bars fall outside the frame's overflow —
 * nothing of the picture is lost, and none of the black survives.
 */
const box = still?.content ?? null;
const ratio = still
  ? (box ? box.width / box.height : still.width / still.height)
  : image
    ? image.width / image.height
    : null;

const cropStyle =
  still && box && (box.width !== still.width || box.height !== still.height)
    ? [
        `--crop-w: ${still.width / box.width}`,
        `--crop-x: ${-box.left / box.width}`,
        `--crop-y: ${-box.top / box.height}`,
      ].join('; ')
    : null;

const mediaStyle = [ratio && `--media-ratio: ${ratio}`, cropStyle]
  .filter(Boolean)
  .join('; ') || undefined;
---

<div class="wrap intro">
  {figure && <Marginalia figure={figure} side="right" top="4%" size={260} />}

  {/* Siblings of the figure rather than children of it, because they are
      anchored to the page's own edges and not to the picture's. The pictures are
      all the same height but deliberately different widths, so an arrow hung off
      the frame lands somewhere new on every project; hung off the wrap, both sit
      in exactly the same place site-wide. */}
  <a class="intro__nav intro__nav--prev" href={prevNav.href}>
    <Icon name="arrow-left" size={16} />
    <span>{prevNav.label}</span>
  </a>

  <a class="intro__nav intro__nav--next" href={nextNav.href}>
    <span>{nextNav.label}</span>
    <Icon name="arrow-right" size={16} />
  </a>

  <figure class:list={['intro__figure', ratio && 'intro__figure--fit']} style={mediaStyle}>
    <div class="intro__media">
      <div class="intro__media-inner">
        {
          still ? (
            <img
              class:list={['intro__still', cropStyle && 'intro__still--cropped']}
              src={still.poster}
              width={still.width}
              height={still.height}
              alt={alt}
            />
          ) : (
            <MediaSlot
              image={image}
              alt={alt}
              widths={[640, 960, 1440]}
              sizes="(min-width: 74rem) 46rem, 90vw"
              iconSize={36}
            />
          )
        }
      </div>
    </div>

    {
      caption && (
        <figcaption class="intro__caption">
          <span class="intro__caption-label label">Featured above:</span> {caption}
        </figcaption>
      )
    }
  </figure>

  {
    eyebrow && (
      <a class="intro__eyebrow" href={eyebrow.href}>
        {eyebrow.label}
      </a>
    )
  }

  <h1 class="intro__title">{title}</h1>

  {/* One band closing the intro: the actions on the left, the facts to their
      right. The slot comes first in source as well as in the layout, so the
      reading order and the visual order agree.

      Actions are a slot rather than a prop so this component stays a general
      opening: it owns where the row sits and what it does to the spacing around
      it, and the caller owns what the link is. */}
  {
    (facts.length > 0 || Astro.slots.has('default')) && (
      <div class="intro__meta">
        {Astro.slots.has('default') && (
          <div class="intro__actions">
            <slot />
          </div>
        )}

        {facts.length > 0 && (
          <dl class="intro__facts">
            {facts.map((fact) => (
              <div class="intro__facts-row">
                <dt class="label">{fact.label}</dt>
                <dd>
                  {fact.href ? (
                    <a href={fact.href} rel="noopener">
                      {fact.value}
                    </a>
                  ) : (
                    fact.value
                  )}
                </dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    )
  }
</div>

<style>
  .intro {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-top: var(--section-y);

    /* Every project's picture is exactly this tall, which is the whole reason
       the number is named: the figure's width is derived from it below, and the
       arrows' vertical centre is derived from it again further down. Change it
       here and the three stay in agreement.

       28rem is not arbitrary — it is the tallest value that keeps every picture
       inside the 46rem column. The widest ratio on the site is the ballistic
       solver's 1176/720, and 28rem x 1.633 = 45.73rem, just inside. At the 30rem
       this used to be, that one picture wanted 49rem, hit the 46rem cap, and
       came out 28.17rem tall while the other five stood at 30rem — which is
       exactly the mismatch this fixes. Anything wider than a 1.64 ratio would
       hit the cap again and crop instead; see `.intro__still`. */
    --hero-h: 28rem;
  }

  /* The figure carries the width so the caption can never be wider than the
     picture it describes — a caption that outruns its image reads as a stray
     line of body copy. */
  .intro__figure {
    max-width: 46rem;
    margin: 0 auto var(--s-6);
  }

  /* Width derived from the shared height and the picture's own aspect, so every
     project's picture is the same height and takes whatever width that costs —
     which is why the widths differ from page to page and the heights do not.
     Nothing is cropped to achieve it: the frame keeps the picture's exact
     aspect, so equal heights fall out of the arithmetic rather than out of a
     crop. The 46rem cap stays as the outer bound and is slack for every current
     picture; if it ever binds, the height shortens on that page alone.

     `max-width` rather than `width` so the figure still shrinks below its ideal
     size on a narrow viewport instead of overflowing. Heights only match where
     there is room for the full width — which is everywhere the arrows are
     visible, since those need a wider viewport still. */
  .intro__figure--fit {
    max-width: min(46rem, calc(var(--hero-h) * var(--media-ratio)));
  }

  /* Holds the rounded, shadowed picture box. The rounding and clipping live on
     `.intro__media-inner` so this stays a plain positioning context. */
  .intro__media {
    position: relative;
    aspect-ratio: 16 / 10;
  }

  .intro__figure--fit .intro__media {
    aspect-ratio: var(--media-ratio);
  }

  /* `position: relative` is load-bearing, not decoration. `.intro__still--cropped`
     below is absolutely positioned and deliberately overflows its frame so the
     black bars baked into the encode fall outside it — and an absolutely
     positioned box is only clipped by an ancestor's `overflow` if that ancestor
     is in its containing-block chain. Without this, the cropped still's
     containing block resolves up to `.intro__media`, this element's
     `overflow: hidden` is skipped entirely, and the bars come back. */
  .intro__media-inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  /* ---- Prev/next arrows ---------------------------------------------------- */

  /* Hidden below 78rem, the width at which a gutter beside the picture exists at
     all — the picture is centred at up to 46rem inside a 78rem page, and there
     is no room either side of it before that. The prev/next nav at the foot of
     the page carries this job on narrower screens. */
  .intro__nav {
    display: none;
  }

  @media (min-width: 78rem) {
    /* Pinned to the wrap's content edges, not to the picture's edges, which is
       what puts both arrows in the same place on all six project pages. The
       pictures share a height but not a width, so anchoring to the frame — what
       this did before — moved each arrow inward or outward according to whichever
       project the visitor happened to be on.

       `left`/`right` resolve against `.intro`'s padding box, so its own
       `padding-inline` has to be paid back explicitly to land on the content
       edge rather than the page edge; `--gutter` is that padding.

       Vertically centred on the picture, computed rather than measured: the
       figure is the first in-flow child of `.intro`, so the picture's top is
       exactly `--section-y` (the intro's `padding-top`) and its centre is half
       the shared height below that. Deriving it from `--hero-h` instead of
       centring on the frame is what keeps the arrows off the caption, which is
       inside the figure and varies in length from page to page.

       The 11rem box is measured: `.wrap` is 78rem with 3rem gutters, so its
       content is 72rem, and the widest picture (45.73rem, the ballistic solver)
       leaves 13.13rem of gutter a side. 11rem plus the `--s-4` offset spends
       12rem of that and keeps over 1rem clear of the picture. A definite width,
       not a max, so both sides are the same size whatever their labels say.
       Re-measure if `--page-max`, `--hero-h`, or the 46rem cap changes. */
    .intro__nav {
      display: flex;
      position: absolute;
      top: calc(var(--section-y) + (var(--hero-h) / 2));
      transform: translateY(-50%);
      align-items: center;
      gap: var(--s-2);
      width: 11rem;
      font-size: var(--text-sm);
      font-weight: 560;
      line-height: 1.35;
      color: var(--ink-secondary);
      text-decoration: none;
      transition: color var(--dur-fast) var(--ease-out);
    }

    .intro__nav:hover {
      color: var(--ink);
    }

    /* Every project title here wraps to two lines at 11rem, and `balance` keeps
       those two lines near-even instead of leaving one word stranded on the
       second — which is what a raw wrap does to "Vision-based Piece Collection"
       and is most of why these read as ragged. Two even lines also keep the
       icon, which is centred against the whole label, sitting sensibly between
       them rather than adrift beside a three-line block. */
    .intro__nav span {
      text-wrap: balance;
    }

    /* The arrow keeps its full 16px in a flex row that is otherwise free to
       shrink it. */
    .intro__nav svg {
      flex: none;
    }

    /* Mirrored, so the pair reads as one control either side of the picture:
       each label sits flush against its own arrow — which is the side away from
       the image — and the slack from a short label like "Portfolio" falls on
       the inside, next to the picture, instead of pushing the text off toward
       the page edge. */
    .intro__nav--prev {
      left: var(--gutter);
      justify-content: flex-start;
      text-align: left;
    }

    .intro__nav--next {
      right: var(--gutter);
      justify-content: flex-end;
      text-align: right;
    }
  }

  /* Sits close under the picture, so it reads as belonging to it rather than as
     the first line of the page. The label is the mono uppercase the system uses
     for every other piece of scaffolding text; the description after it is plain
     sentence-case prose, because that is what it is. */
  .intro__caption {
    margin-top: var(--s-3);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  .intro__caption-label {
    color: var(--ink-tertiary);
  }

  .intro__still {
    width: 100%;
    height: 100%;
    /* A no-op for every picture currently on the site: the frame is derived from
       the picture's own aspect, so there is nothing to crop either way. It is
       `cover` rather than `contain` only as the honest failure mode for a future
       picture wider than a 1.64 ratio, which would hit the 46rem cap and leave
       the frame shorter than its own aspect wants — `cover` trims the top and
       bottom to fit, where `contain` would letterbox it in bars, and bars are
       the one thing every other rule in this file exists to avoid. */
    object-fit: cover;
    display: block;
  }

  /* A still whose file is bigger than its picture — black bars baked in around
     the footage. The frame is already the picture's aspect, so scaling the image
     by file-width / picture-width makes the picture exactly fill the frame, and
     the offsets push the bars out past `overflow: hidden`. Percentages resolve
     against the frame, so this holds at every width with no media queries and
     no second copy of the file. */
  .intro__still--cropped {
    position: absolute;
    /* The global reset caps every image at `max-width: 100%`, which is right
       everywhere else and exactly wrong here: overflowing the frame is the
       mechanism. */
    max-width: none;
    width: calc(100% * var(--crop-w));
    height: auto;
    left: calc(100% * var(--crop-x));
    top: calc(100% * var(--crop-y));
  }

  .intro__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--accent-blue-dark);
    text-decoration: none;
    margin-bottom: var(--s-3);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .intro__eyebrow:hover {
    border-bottom-color: currentColor;
  }

  .intro__title {
    font-size: var(--text-3xl);
    letter-spacing: -0.038em;
    line-height: 1;
    margin-bottom: var(--s-5);
    max-width: 26ch;
  }

  /* The source button and the Languages / Tools / When facts on one line,
     directly under the title: button hard left, facts pushed to its right. It
     carries the closing gap for the whole intro, since this is the last thing in
     it — the Overview section below brings its own top rule and padding.

     Stacked below 34rem, where the facts themselves stack and a row of both
     would not fit. */
  .intro__meta {
    display: grid;
    gap: var(--s-5);
    margin-bottom: var(--s-7);
  }

  @media (min-width: 34rem) {
    .intro__meta {
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      /* Against the facts' own label/value pair rather than centred on it: the
         button lines up with the values, which is the row the eye reads. */
      align-items: end;
      gap: var(--s-9);
    }
  }

  /* Built with / When / Team. */
  .intro__facts {
    display: grid;
    gap: var(--s-5);
    margin: 0;
  }

  @media (min-width: 34rem) {
    .intro__facts {
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      gap: var(--s-9);
    }
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .intro__facts-row dt {
    margin-bottom: var(--s-1);
  }

  .intro__facts-row dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }
</style>
