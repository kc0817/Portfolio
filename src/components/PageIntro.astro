---
import type { ImageMetadata } from 'astro';
import MediaSlot from './MediaSlot.astro';
import Marginalia from './Marginalia.astro';

/**
 * The first thing on every division page and every project page: a contained
 * photo (never full-bleed — the point is a framed picture, not another hero),
 * the title, then an Overview paragraph. Division pages pass no `eyebrow`,
 * since the division name only needs a link back to itself on project pages.
 */
interface Props {
  image: ImageMetadata | null;
  /**
   * A clip to run in the slot instead of the still. Its real pixel dimensions
   * come with it so the frame can take the clip's own aspect ratio — the point
   * of this slot is the footage uncropped, and a fixed 16/10 frame would crop
   * anything that is not already 16/10.
   */
  video?: { src: string; poster: string; width: number; height: number } | null;
  alt: string;
  title: string;
  overview: string;
  eyebrow?: { label: string; href: string };
  figure?: 'rays' | 'linkage' | 'trajectory' | 'contours' | 'spline' | 'cube';
}

const { image, video = null, alt, title, overview, eyebrow, figure } = Astro.props;

/**
 * A clip taller than it is wide would otherwise push the title off the first
 * screen, so the frame is capped by height and gives up width to stay under
 * the cap — `--media-ratio` is what lets the CSS trade one for the other. A
 * 16/9 clip is limited by the 46rem column and never reaches the cap; a square
 * one narrows to about 30rem and sits centred.
 */
const mediaStyle = video ? `--media-ratio: ${video.width / video.height}` : undefined;
---

<div class="wrap intro">
  {figure && <Marginalia figure={figure} side="right" top="4%" size={260} />}

  <div class:list={['intro__media', video && 'intro__media--video']} style={mediaStyle}>
    <MediaSlot
      video={video}
      videoControls={true}
      image={image}
      alt={alt}
      widths={[640, 960, 1440]}
      sizes="(min-width: 74rem) 46rem, 90vw"
      iconSize={36}
    />
  </div>

  {
    eyebrow && (
      <a class="intro__eyebrow" href={eyebrow.href}>
        {eyebrow.label}
      </a>
    )
  }

  <h1 class="intro__title">{title}</h1>

  <section class="intro__overview">
    <p class="intro__overview-label label">Overview</p>
    <p class="intro__overview-text">{overview}</p>
  </section>
</div>

<style>
  .intro {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-top: var(--section-y);
  }

  .intro__media {
    max-width: 46rem;
    margin-inline: auto;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    margin-bottom: var(--s-6);
  }

  /* The clip's own aspect, so nothing is cropped; then a height ceiling that
     the width yields to, so a tall clip narrows rather than shoving the title
     off the screen. Both branches keep the 46rem column as the outer bound. */
  .intro__media--video {
    aspect-ratio: var(--media-ratio);
    max-width: min(46rem, calc(30rem * var(--media-ratio)));
  }

  .intro__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--accent-blue-dark);
    text-decoration: none;
    margin-bottom: var(--s-3);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .intro__eyebrow:hover {
    border-bottom-color: currentColor;
  }

  .intro__title {
    font-size: var(--text-3xl);
    letter-spacing: -0.038em;
    line-height: 1;
    margin-bottom: var(--s-5);
    max-width: 26ch;
  }

  .intro__overview {
    margin-bottom: var(--s-7);
  }

  .intro__overview-label {
    margin-bottom: var(--s-2);
  }

  .intro__overview-text {
    font-size: var(--text-lg);
    color: var(--ink-secondary);
  }
</style>
