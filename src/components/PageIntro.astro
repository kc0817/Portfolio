---
import type { ImageMetadata } from 'astro';
import MediaSlot from './MediaSlot.astro';
import Marginalia from './Marginalia.astro';
import Icon from './Icon.astro';
import type { Still } from '../lib/projectMedia';

/**
 * The first thing on a project page: a contained photo (never full-bleed — the
 * point is a framed picture, not another hero), the title, then an Overview
 * paragraph. It used to open the division pages too, which is why the props are
 * written as a general opening rather than as a project's opening; the division
 * pages are gone, but nothing here is specific to a project either, so the shape
 * has been left alone.
 */
interface Props {
  image: ImageMetadata | null;
  /**
   * A still that lives in `public/` rather than the asset pipeline — the project
   * clip's poster, which is frame 0 of that clip. This slot shows the picture and
   * nothing else: the clip belongs to the card the visitor hovered to get here,
   * where motion answers attention instead of demanding it on arrival.
   *
   * Its real pixel dimensions come with it so the frame can take the picture's
   * own aspect ratio — a fixed 16/10 frame would crop anything that is not
   * already 16/10 — and `content` says where the picture actually sits inside
   * those dimensions, since these encodes carry black bars.
   */
  still?: Still | null;
  alt: string;
  /**
   * What the picture above is, in the visitor's terms — captioned under it, not
   * hidden in `alt`. A demo still is one frame of a running program, so what it
   * shows is worth saying; a plain poster from frontmatter is a picture of the
   * thing the page is already titled after, and takes no caption.
   */
  caption?: string | null;
  title: string;
  eyebrow?: { label: string; href: string };
  figure?: 'rays' | 'linkage' | 'trajectory' | 'contours' | 'spline' | 'cube';
  /**
   * Where "Return to Portfolio" points — the home page's anchor for this
   * project's division (`/#robotics` and so on), which is where the project
   * is actually reachable from rather than a generic home link.
   */
  backHref: string;
  /**
   * Built with / When / Team — the last thing in the opening block, directly
   * under the title. The Overview paragraph used to sit between the two; it is
   * now its own section below this component, so the facts close the intro.
   */
  facts?: { label: string; value: string; href?: string }[];
}

const {
  image,
  still = null,
  alt,
  caption = null,
  title,
  eyebrow,
  figure,
  backHref,
  facts = [],
} = Astro.props;

/**
 * The frame takes the picture's own aspect ratio, so nothing in this slot is
 * ever cropped: the `still` carries its dimensions, and an `image` from the
 * asset pipeline already knows its own. A picture taller than it is wide would
 * otherwise push the title off the first screen, so the frame is capped by
 * height and gives up width to stay under the cap — `--media-ratio` is what
 * lets the CSS trade one for the other. A 16/9 picture is limited by the 46rem
 * column and never reaches the cap; a square one narrows to about 30rem and
 * sits centred.
 *
 * When the still declares a `content` box smaller than the file, the aspect
 * that matters is the picture's, not the encode's: the black bars around it are
 * baked into the file, and the frame should be the shape of what is worth
 * looking at. `--crop-*` then scales the image so the content box exactly fills
 * that frame and offsets it so the bars fall outside the frame's overflow —
 * nothing of the picture is lost, and none of the black survives.
 */
const box = still?.content ?? null;
const ratio = still
  ? (box ? box.width / box.height : still.width / still.height)
  : image
    ? image.width / image.height
    : null;

const cropStyle =
  still && box && (box.width !== still.width || box.height !== still.height)
    ? [
        `--crop-w: ${still.width / box.width}`,
        `--crop-x: ${-box.left / box.width}`,
        `--crop-y: ${-box.top / box.height}`,
      ].join('; ')
    : null;

const mediaStyle = [ratio && `--media-ratio: ${ratio}`, cropStyle]
  .filter(Boolean)
  .join('; ') || undefined;
---

<div class="wrap intro">
  {figure && <Marginalia figure={figure} side="right" top="4%" size={260} />}

  <a class="intro__back" href={backHref}>
    <Icon name="arrow-left" size={16} />
    Return to Portfolio
  </a>

  <figure class:list={['intro__figure', ratio && 'intro__figure--fit']} style={mediaStyle}>
    <div class="intro__media">
      {
        still ? (
          <img
            class:list={['intro__still', cropStyle && 'intro__still--cropped']}
            src={still.poster}
            width={still.width}
            height={still.height}
            alt={alt}
          />
        ) : (
          <MediaSlot
            image={image}
            alt={alt}
            widths={[640, 960, 1440]}
            sizes="(min-width: 74rem) 46rem, 90vw"
            iconSize={36}
          />
        )
      }
    </div>

    {
      caption && (
        <figcaption class="intro__caption">
          <span class="intro__caption-label label">Featured above:</span> {caption}
        </figcaption>
      )
    }
  </figure>

  {
    eyebrow && (
      <a class="intro__eyebrow" href={eyebrow.href}>
        {eyebrow.label}
      </a>
    )
  }

  <h1 class="intro__title">{title}</h1>

  {
    facts.length > 0 && (
      <dl class="intro__facts">
        {facts.map((fact) => (
          <div class="intro__facts-row">
            <dt class="label">{fact.label}</dt>
            <dd>
              {fact.href ? (
                <a href={fact.href} rel="noopener">
                  {fact.value}
                </a>
              ) : (
                fact.value
              )}
            </dd>
          </div>
        ))}
      </dl>
    )
  }
</div>

<style>
  .intro {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-top: var(--section-y);
  }

  /* Below 78rem there is not reliably enough room beside the centred 46rem
     figure for the link's own text, so it is a plain line above the image.
     From 78rem up it moves into the side column instead, anchored to the
     picture rather than to the page edge — see the media query below for why
     that breakpoint is 78rem and not the 74rem it used to be. */
  .intro__back {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-5);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-tertiary);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .intro__back:hover {
    color: var(--ink);
  }

  /* Anchored to the picture, not to the page edge: `right` holds the link a
     constant `--s-5` clear of the figure's left edge, so as the viewport grows
     the link stays visually attached to the image instead of drifting off toward
     the corner. `50%` is the wrap's centre and the figure is centred on it, so
     half the figure's width plus the gap is the whole offset. Top-aligned with
     the figure via `--section-y`, the same offset that gives the figure its own
     top spacing.

     The breakpoint is measured, and it moved from 74rem to 78rem when the
     anchor changed: "Return to Portfolio" sets about 11rem wide, the figure
     takes 46rem centred, and the gutters are 3rem each, so the link's left edge
     lands at `wrap/2 - 35.5rem`. That is only positive from a 71rem wrap — a
     77rem viewport — and 78rem is both the next round number and `--page-max`.
     Below it the link is the plain line above the image. Re-measure this if the
     link's wording or the figure's 46rem cap ever changes.

     One known slack: a portrait still narrows the figure below 46rem via
     `--fit`, and nothing here can read that rendered width, so the gap opens up
     wider than `--s-5` on those pages. It is a larger gap, never a collision. */
  @media (min-width: 78rem) {
    .intro__back {
      position: absolute;
      top: var(--section-y);
      right: calc(50% + (46rem / 2) + var(--s-5));
      margin-bottom: 0;
    }
  }

  /* The figure carries the width so the caption can never be wider than the
     picture it describes — a caption that outruns its image reads as a stray
     line of body copy. */
  .intro__figure {
    max-width: 46rem;
    margin: 0 auto var(--s-6);
  }

  /* The picture's own aspect, so nothing is cropped; then a height ceiling that
     the width yields to, so a tall picture narrows rather than shoving the
     title off the screen. Both branches keep the 46rem column as the outer
     bound. */
  .intro__figure--fit {
    max-width: min(46rem, calc(30rem * var(--media-ratio)));
  }

  .intro__media {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .intro__figure--fit .intro__media {
    aspect-ratio: var(--media-ratio);
  }

  /* Sits close under the picture, so it reads as belonging to it rather than as
     the first line of the page. The label is the mono uppercase the system uses
     for every other piece of scaffolding text; the description after it is plain
     sentence-case prose, because that is what it is. */
  .intro__caption {
    margin-top: var(--s-3);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  .intro__caption-label {
    color: var(--ink-tertiary);
  }

  .intro__still {
    width: 100%;
    height: 100%;
    /* `contain` rather than `cover`: the frame is already the picture's own
       aspect, so there is nothing to crop and rounding should not shave an
       edge off. */
    object-fit: contain;
    display: block;
  }

  /* A still whose file is bigger than its picture — black bars baked in around
     the footage. The frame is already the picture's aspect, so scaling the image
     by file-width / picture-width makes the picture exactly fill the frame, and
     the offsets push the bars out past `overflow: hidden`. Percentages resolve
     against the frame, so this holds at every width with no media queries and
     no second copy of the file. */
  .intro__still--cropped {
    position: absolute;
    /* The global reset caps every image at `max-width: 100%`, which is right
       everywhere else and exactly wrong here: overflowing the frame is the
       mechanism. */
    max-width: none;
    width: calc(100% * var(--crop-w));
    height: auto;
    left: calc(100% * var(--crop-x));
    top: calc(100% * var(--crop-y));
  }

  .intro__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--accent-blue-dark);
    text-decoration: none;
    margin-bottom: var(--s-3);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .intro__eyebrow:hover {
    border-bottom-color: currentColor;
  }

  .intro__title {
    font-size: var(--text-3xl);
    letter-spacing: -0.038em;
    line-height: 1;
    margin-bottom: var(--s-5);
    max-width: 26ch;
  }

  /* Built with / When / Team, closing the opening block directly under the
     title. The bottom margin is the intro's own, since this is now the last
     thing in it — the Overview section below brings its own top rule and
     padding. */
  .intro__facts {
    display: grid;
    gap: var(--s-5);
    margin: 0 0 var(--s-7);
  }

  @media (min-width: 34rem) {
    .intro__facts {
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      gap: var(--s-9);
    }
  }

  .intro__facts-row dt {
    margin-bottom: var(--s-1);
  }

  .intro__facts-row dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }
</style>
